__pycache__/
*.py[cod]
.venv/
.ruff_cache/
.freebuff/

# `.env` holds HF_TOKEN, which the Docker build consumes via
# `--secret id=hf_token,env=HF_TOKEN`. It is a FILE -- the .venv/ entry above is
# the virtualenv and the two are easy to confuse. `.env.*` covers the
# per-machine variants, so a token never reaches the repository.
.env
.env.*
headers*.txt
*.hdr

# Every take the app writes is runtime data, not source. Both the WAVs and
# their JSON sidecars are ignored; .gitkeep holds the folder itself.
outputs/*
!outputs/.gitkeep

# The in-place update marker and backup directory, written by POST /api/update.
.tostai_rev
.update_backup/

*.wav
*.pcm
*.log